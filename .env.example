# Copie este archivo como .env y ajuste los valores.

PUERTO=3000

# --- SQL Server ---
DB_SERVIDOR=localhost
# Para una instancia con nombre: localhost\SQLEXPRESS
DB_BASE=ASADA
DB_BASE_DW=ASADA_DW
DB_DRIVER=ODBC Driver 18 for SQL Server
# windows = usa la cuenta de Windows que ejecuta la API (Trusted_Connection)
# sql     = usa DB_USUARIO y DB_CONTRASENA (requiere autenticación mixta en el servidor)
DB_AUTENTICACION=windows
DB_USUARIO=
DB_CONTRASENA=
# Tiempo máximo por consulta (respaldos, restauraciones y ETL pueden tardar)
DB_TIMEOUT_MS=300000

# --- Sesión (JWT) ---
# Genere uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRETO=
JWT_EXPIRA=8h

# Intentos fallidos de inicio de sesión permitidos por IP en la ventana (minutos).
# Al pasar el límite la API responde 429 hasta que termine la ventana.
LOGIN_MAX_FALLOS=10
LOGIN_VENTANA_MIN=15

# Orígenes permitidos para el front, separados por coma. * = cualquiera (solo desarrollo)
CORS_ORIGEN=http://localhost:5173

# Expone /api/pruebas/* (cargar datos de prueba, ejecutar casos). Nunca en producción.
PERMITIR_PRUEBAS=false
